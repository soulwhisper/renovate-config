{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Disable Docker digest updates entirely",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Keep GitHub Actions at major tags only",
      "matchManagers": ["github-actions"],
      "pinDigests": false
    }
  ]
}
